# Porta HTTP do sistema
PORT=3000

# Caminho do banco SQLite (troque por Postgres quando escalar)
DATABASE_PATH=./data/nfse.db

# Chave-mestra (32 bytes em base64) usada para criptografar os certificados A1 e as senhas.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GUARDE EM LOCAL SEGURO: sem ela, os certificados salvos não podem ser lidos.
MASTER_KEY=

# Segredo para assinar os tokens de login (qualquer string longa e aleatória)
SESSION_SECRET=

# Identificação do aplicativo enviada no campo verAplic da DPS (até 20 caracteres)
VER_APLIC=EmissorEscritorio1.0

# Usuário administrador criado na primeira execução
ADMIN_EMAIL=admin@escritorio.com.br
ADMIN_SENHA=troque-esta-senha

# Pasta onde os XML e PDFs das notas são arquivados
STORAGE_DIR=./data/arquivos
